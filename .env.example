# Chat Service Supabase (separate instance - create at supabase.com)
SUPABASE_URL=https://your-chat-supabase.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Auth Service URL (for JWKS and user lookups)
AUTH_SERVICE_URL=https://auth.peeap.com

# Internal service secret (must match auth service)
SERVICE_SECRET=your-internal-service-secret

# CORS allowed origins
ALLOWED_ORIGINS=https://my.peeap.com,https://checkout.peeap.com,https://school.peeap.com,https://plus.peeap.com,https://store.peeap.com

# App URL
NEXT_PUBLIC_APP_URL=https://chat.peeap.com
NEXT_PUBLIC_SUPABASE_URL=https://your-chat-supabase.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
